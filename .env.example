# CryptoAgent environment variables
# Copy this file to `.env` and fill in values as needed.
#
# Phase 1 uses only PUBLIC market data, so these keys are OPTIONAL and unused.
# They are required only for later phases (live order execution).
# NEVER commit your real .env file.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional Telegram alerts (leave blank to disable). See docs/SETUP_N8N.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
